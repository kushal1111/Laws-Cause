# Public site origin used for canonical URLs, Open Graph tags, and the sitemap.
# Set this to the production domain before launch. No trailing slash.
VITE_SITE_URL=https://example.com

# Contact form delivery: demo | endpoint | function
# demo — validates in the browser and clearly states that nothing was sent.
# endpoint — POSTs JSON to VITE_FORM_ENDPOINT (a public form URL, never a secret key).
# function — POSTs JSON to /api/contact (Cloudflare Pages Function).
VITE_FORM_MODE=demo

# Used only when VITE_FORM_MODE=endpoint. Example: https://formspree.io/f/your-id
VITE_FORM_ENDPOINT=

# Public Cloudflare Turnstile site key. The secret key is NOT set here.
# Set TURNSTILE_SECRET_KEY in the Cloudflare dashboard for the Pages Function.
VITE_TURNSTILE_SITE_KEY=

# Server-only variables. Set these in Cloudflare Pages, never with a VITE_ prefix.
# RESEND_API_KEY=
# CONTACT_TO=
# CONTACT_FROM=
# TURNSTILE_SECRET_KEY=
